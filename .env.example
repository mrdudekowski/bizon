# Public (client-safe). Real production values are required before release.
NEXT_PUBLIC_SITE_URL=
MEDIA_SOURCE=local
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=

# Yandex Metrika (optional — analytics disabled when empty)
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# Payload CMS (server-only — do NOT prefix with NEXT_PUBLIC_)
DATABASE_URI=postgresql://postgres:postgres@127.0.0.1:5433/bizon
PAYLOAD_SECRET=change-me-to-a-long-random-string-min-32-chars

# S3-compatible media (Prompt 05) — server-only, never NEXT_PUBLIC_
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_ENDPOINT=
# Public CDN/base URL for file links (R2 custom domain, CloudFront, MinIO public URL)
S3_PUBLIC_URL=
# Set true for MinIO / path-style endpoints (recommended for Timeweb S3)
S3_FORCE_PATH_STYLE=true
# Private bucket (Timeweb default): files served via Payload /api/media/file/...
S3_ACL=private
S3_PRIVATE=true
# Notifications (Prompt 07) — server-only, never NEXT_PUBLIC_
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional admin URL for links inside Telegram messages
PAYLOAD_ADMIN_URL=
# Optional email fallback
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
REQUESTS_EMAIL_TO=
# Public write API rate limiting (server-only)
# API_RATE_LIMIT_DISABLED=1
API_RATE_LIMIT_MAX=30
API_RATE_LIMIT_WINDOW_MS=60000
